<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>EduSync AI Demo</title>
<style>
*{box-sizing:border-box}body{margin:0;font-family:Arial,sans-serif;background:#f3f7fc;color:#18304d}header{background:#10294d;color:white;padding:20px}header b{font-size:24px}header small{display:block;color:#c8dcf5;margin-top:5px}nav{display:flex;gap:7px;flex-wrap:wrap;background:white;padding:12px;position:sticky;top:0}button{border:0;border-radius:8px;padding:11px 14px;background:#e8f1ff;color:#174477;font-weight:bold}nav button.active,.primary{background:#2878d0;color:white}main{max-width:850px;margin:22px auto;padding:0 14px}.page{display:none}.page.active{display:block}.card{background:white;padding:18px;border:1px solid #dce6f2;border-radius:13px;margin:12px 0}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px}.metric{font-size:30px;color:#2878d0;font-weight:bold}p,.muted{color:#64748b}form{display:grid;gap:10px;margin:14px 0}input,select,textarea{width:100%;padding:11px;border:1px solid #cbd7e5;border-radius:8px;font:inherit}textarea{min-height:80px}.row{display:grid;grid-template-columns:1fr 1fr;gap:10px}.item{padding:12px 0;border-bottom:1px solid #e4ebf3;display:flex;justify-content:space-between;gap:10px;align-items:center}.tag{background:#eaf2ff;padding:5px 8px;border-radius:20px;font-size:12px}.note{font-size:12px;line-height:1.5;margin:22px 0;color:#66758a}@media(max-width:420px){.row{grid-template-columns:1fr}}
</style></head><body>
<header><b>EduSync AI</b><small>Smarter Schools, Better Learning</small></header>
<nav><button class="active" onclick="page('dashboard',this)">Dashboard</button><button onclick="page('homework',this)">Homework</button><button onclick="page('attendance',this)">Attendance</button><button onclick="page('complaints',this)">Complaints</button></nav>
<main>
<section id="dashboard" class="page active"><h1>Welcome to EduSync AI</h1><p>A simple school-management website demonstration.</p><div class="grid"><div class="card">Homework tasks<div class="metric" id="hc">0</div></div><div class="card">Attendance records<div class="metric" id="ac">0</div></div><div class="card">Complaints<div class="metric" id="cc">0</div></div></div><div class="card"><h3>One platform for your school</h3><p>Manage homework, record attendance and receive student concerns.</p></div></section>
<section id="homework" class="page"><h1>Homework management</h1><div class="card"><h3>Add homework</h3><form id="hf"><div class="row"><input id="subject" placeholder="Subject" required><input id="due" type="date" required></div><textarea id="task" placeholder="Homework details" required></textarea><button class="primary">Add homework</button></form><h3>Assignments</h3><div id="hl"></div></div></section>
<section id="attendance" class="page"><h1>Smart attendance</h1><div class="card"><form id="af"><input id="student" placeholder="Student name" required><select id="status"><option>Present</option><option>Absent</option><option>Late</option></select><button class="primary">Save attendance</button></form><h3>Attendance register</h3><div id="al"></div></div></section>
<section id="complaints" class="page"><h1>Student complaint system</h1><div class="card"><form id="cf"><input id="reporter" placeholder="Your name (optional)"><textarea id="message" placeholder="Describe your concern" required></textarea><select id="category"><option>General concern</option><option>Bullying or student safety</option><option>Facilities</option><option>Teaching or classroom</option><option>Other</option></select><button class="primary">Submit complaint</button></form><h3>Submitted complaints</h3><div id="cl"></div></div></section>
<p class="note"><b>Prototype only:</b> Entries are saved in this browser on this device. This demo is not connected to a real school database, staff accounts, notifications or a live AI service. Do not enter real or sensitive student information.</p>
</main>
<script>
const get=k=>JSON.parse(localStorage.getItem('edu_'+k)||'[]'),put=(k,v)=>localStorage.setItem('edu_'+k,JSON.stringify(v));
function safe(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function page(id,b){document.querySelectorAll('.page').forEach(x=>x.classList.toggle('active',x.id===id));document.querySelectorAll('nav button').forEach(x=>x.classList.remove('active'));b.classList.add('active');render()}
function render(){let h=get('h'),a=get('a'),c=get('c');hc.textContent=h.length;ac.textContent=a.length;cc.textContent=c.length;
hl.innerHTML=h.map(x=>`<div class="item"><div><b>${safe(x.s)}</b><p>${safe(x.t)} · Due ${safe(x.d)}</p></div></div>`).join('')||'<p>No homework yet.</p>';
al.innerHTML=a.map(x=>`<div class="item"><b>${safe(x.n)}</b><span class="tag">${safe(x.s)}</span></div>`).join('')||'<p>No attendance records yet.</p>';
cl.innerHTML=c.map((x,i)=>`<div class="item"><div><b>${safe(x.cat)}</b><p>${safe(x.msg)} · ${safe(x.name||'Anonymous')}</p></div><select onchange="changeStatus(${i},this.value)"><option ${x.st==='Received'?'selected':''}>Received</option><option ${x.st==='Under review'?'selected':''}>Under review</option><option ${x.st==='Resolved'?'selected':''}>Resolved</option></select></div>`).join('')||'<p>No complaints yet.</p>'}
function changeStatus(i,v){let a=get('c');a[i].st=v;put('c',a);render()}
hf.onsubmit=e=>{e.preventDefault();let a=get('h');a.unshift({s:subject.value,d:due.value,t:task.value});put('h',a);hf.reset();render()};
af.onsubmit=e=>{e.preventDefault();let a=get('a');a.unshift({n:student.value,s:status.value});put('a',a);af.reset();render()};
cf.onsubmit=e=>{e.preventDefault();let a=get('c');a.unshift({name:reporter.value,msg:message.value,cat:category.value,st:'Received'});put('c',a);cf.reset();render();alert('Demo complaint submitted')};render();
</script></body></html>
