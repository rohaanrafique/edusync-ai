
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>EduSync AI | School Management</title>

<style>
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: Arial, sans-serif;
}

body {
  background: #f1f5f9;
  color: #172033;
}

header {
  background: #111c3a;
  color: white;
  padding: 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 10px;
}

header h1 {
  font-size: 24px;
}

header span {
  color: #60a5fa;
}

.container {
  display: flex;
  min-height: calc(100vh - 70px);
}

.sidebar {
  width: 230px;
  background: #17264a;
  padding: 20px 12px;
  color: white;
  flex-shrink: 0;
}

.sidebar button {
  display: block;
  width: 100%;
  padding: 13px;
  margin: 7px 0;
  border: none;
  border-radius: 8px;
  background: transparent;
  color: white;
  text-align: left;
  font-size: 15px;
  cursor: pointer;
}

.sidebar button:hover,
.sidebar button.active {
  background: #2563eb;
}

main {
  flex: 1;
  padding: 28px;
  min-width: 0;
}

.page {
  display: none;
}

.page.active {
  display: block;
}

h2 {
  margin-bottom: 10px;
  color: #14213d;
}

.subtitle {
  color: #64748b;
  margin-bottom: 22px;
}

.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
  gap: 18px;
  margin: 22px 0;
}

.card {
  background: white;
  padding: 22px;
  border-radius: 13px;
  box-shadow: 0 3px 12px rgba(0,0,0,0.06);
}

.card h3 {
  color: #64748b;
  font-size: 14px;
  margin-bottom: 12px;
}

.card strong {
  font-size: 29px;
  color: #2563eb;
}

.panel {
  background: white;
  padding: 22px;
  border-radius: 13px;
  margin-top: 20px;
  box-shadow: 0 3px 12px rgba(0,0,0,0.05);
}

form {
  display: grid;
  gap: 13px;
  max-width: 650px;
}

input, select, textarea {
  width: 100%;
  padding: 12px;
  border: 1px solid #cbd5e1;
  border-radius: 8px;
  font-size: 15px;
  background: white;
}

textarea {
  min-height: 100px;
  resize: vertical;
}

.primary {
  background: #2563eb;
  color: white;
  padding: 12px 18px;
  border: none;
  border-radius: 8px;
  cursor: pointer;
  font-size: 15px;
}

.primary:hover {
  background: #1d4ed8;
}

.item {
  background: #f8fafc;
  border-left: 4px solid #2563eb;
  padding: 14px;
  margin: 12px 0;
  border-radius: 7px;
  overflow-wrap: anywhere;
}

.empty {
  color: #64748b;
  padding: 12px 0;
}

footer {
  text-align: center;
  padding: 20px;
  color: #64748b;
}

@media (max-width: 700px) {
  .container {
    display: block;
  }

  .sidebar {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 5px;
  }

  .sidebar button {
    font-size: 13px;
    padding: 11px 8px;
  }

  main {
    padding: 18px;
  }

  header h1 {
    font-size: 20px;
  }
}
</style>
</head>

<body>

<header>
  <h1>🎓 EduSync <span>AI</span></h1>
  <p>Smart School Management System</p>
</header>

<div class="container">

  <nav class="sidebar">
    <button class="active" onclick="showPage('dashboard', this)">🏠 Dashboard</button>
    <button onclick="showPage('homework', this)">📚 Homework</button>
    <button onclick="showPage('attendance', this)">✅ Attendance</button>
    <button onclick="showPage('complaints', this)">🤖 AI Complaints</button>
    <button onclick="showPage('help', this)">❓ Help Center</button>
    <button onclick="showPage('reviews', this)">⭐ Reviews</button>
  </nav>

  <main>

    <!-- DASHBOARD -->
    <section id="dashboard" class="page active">
      <h2>Welcome to EduSync AI 👋</h2>
      <p class="subtitle">Your smart school management dashboard.</p>

      <div class="cards">
        <div class="card">
          <h3>Homework Tasks</h3>
          <strong id="homeworkCount">0</strong>
        </div>

        <div class="card">
          <h3>Attendance Records</h3>
          <strong id="attendanceCount">0</strong>
        </div>

        <div class="card">
          <h3>Student Complaints</h3>
          <strong id="complaintCount">0</strong>
        </div>

        <div class="card">
          <h3>Student Reviews</h3>
          <strong id="reviewCount">0</strong>
        </div>
      </div>

      <div class="panel">
        <h2>About EduSync AI</h2>
        <p>
          EduSync AI is a smart school management platform designed
          to make school activities easier, faster and more organized.
        </p>
        <br>
        <p>Use the menu to explore the different features.</p>
      </div>

      <div class="panel">
        <h2>Recent Activity</h2>
        <div id="recentActivity" class="empty">No activity yet.</div>
      </div>
    </section>

    <!-- HOMEWORK -->
    <section id="homework" class="page">
      <h2>📚 Homework Automation</h2>
      <p class="subtitle">Add and manage student homework.</p>

      <div class="panel">
        <form id="homeworkForm">
          <input id="hwSubject" placeholder="Subject name" required>
          <input id="hwClass" placeholder="Class or grade" required>
          <textarea id="hwDetails" placeholder="Homework details" required></textarea>
          <label>Due date</label>
          <input id="hwDate" type="date" required>
          <button class="primary" type="submit">Add Homework</button>
        </form>
      </div>

      <div class="panel">
        <h2>Assigned Homework</h2>
        <div id="homeworkList" class="empty">No homework added yet.</div>
      </div>
    </section>

    <!-- ATTENDANCE -->
    <section id="attendance" class="page">
      <h2>✅ Smart Attendance</h2>
      <p class="subtitle">Record student attendance.</p>

      <div class="panel">
        <form id="attendanceForm">
          <input id="attName" placeholder="Student name" required>
          <input id="attClass" placeholder="Class or grade" required>
          <select id="attStatus" required>
            <option value="">Select attendance</option>
            <option>Present</option>
            <option>Absent</option>
            <option>Late</option>
          </select>
          <button class="primary" type="submit">Save Attendance</button>
        </form>
      </div>

      <div class="panel">
        <h2>Attendance Records</h2>
        <div id="attendanceList" class="empty">No records yet.</div>
      </div>
    </section>

    <!-- COMPLAINTS -->
    <section id="complaints" class="page">
      <h2>🤖 AI Student Complaint System</h2>
      <p class="subtitle">Submit a complaint and receive an automatic demo response.</p>

      <div class="panel">
        <form id="complaintForm">
          <input id="compName" placeholder="Student name" required>
          <select id="compCategory" required>
            <option value="">Choose complaint category</option>
            <option>Academic Problem</option>
            <option>Teacher Related</option>
            <option>Classroom Facilities</option>
            <option>Bullying or Safety</option>
            <option>Other</option>
          </select>
          <textarea id="compText" placeholder="Describe your complaint..." required></textarea>
          <button class="primary" type="submit">Submit Complaint</button>
        </form>
      </div>

      <div class="panel">
        <h2>Complaint Responses</h2>
        <div id="complaintList" class="empty">No complaints submitted yet.</div>
      </div>
    </section>

    <!-- HELP CENTER -->
    <section id="help" class="page">
      <h2>❓ Help Center</h2>
      <p class="subtitle">Find answers to common school questions.</p>

      <div class="panel">
        <h3>Frequently Asked Questions</h3>
        <div class="item"><b>How can I check my homework?</b><br>Open the Homework section to view assigned tasks.</div>
        <div class="item"><b>How can I check attendance?</b><br>Open the Attendance section to view attendance records.</div>
        <div class="item"><b>How can I submit a complaint?</b><br>Open the AI Complaints section and complete the form.</div>
        <div class="item"><b>How can I give feedback?</b><br>Open the Reviews section and submit your review.</div>
      </div>

      <div class="panel">
        <h3>Ask a Question</h3>
        <form id="helpForm">
          <textarea id="helpQuestion" placeholder="Type your question..." required></textarea>
          <button class="primary" type="submit">Get Help</button>
        </form>
        <div id="helpAnswer"></div>
      </div>
    </section>

    <!-- REVIEWS -->
    <section id="reviews" class="page">
      <h2>⭐ Student Reviews</h2>
      <p class="subtitle">Share your experience and feedback.</p>

      <div class="panel">
        <form id="reviewForm">
          <input id="reviewStudent" placeholder="Your name" required>
          <select id="reviewRating" required>
            <option value="">Choose rating</option>
            <option value="5">⭐⭐⭐⭐⭐ Excellent</option>
            <option value="4">⭐⭐⭐⭐ Very Good</option>
            <option value="3">⭐⭐⭐ Good</option>
            <option value="2">⭐⭐ Fair</option>
            <option value="1">⭐ Needs Improvement</option>
          </select>
          <textarea id="reviewMessage" placeholder="Write your review..." required></textarea>
          <button class="primary" type="submit">Submit Review</button>
        </form>
      </div>

      <div class="panel">
        <h2>Student Feedback</h2>
        <div id="reviewList" class="empty">No reviews yet.</div>
      </div>
    </section>

  </main>
</div>

<footer>
  © 2026 EduSync AI | Smart School Management System
</footer>

<script>
function getData(key) {
  try {
    return JSON.parse(localStorage.getItem(key)) || [];
  } catch (error) {
    return [];
  }
}

function saveData(key, data) {
  localStorage.setItem(key, JSON.stringify(data));
}

function showPage(pageId, button) {
  document.querySelectorAll(".page").forEach(function(page) {
    page.classList.remove("active");
  });

  document.getElementById(pageId).classList.add("active");

  document.querySelectorAll(".sidebar button").forEach(function(btn) {
    btn.classList.remove("active");
  });

  button.classList.add("active");
}

function renderAll() {
  const homework = getData("edu_homework");
  const attendance = getData("edu_attendance");
  const complaints = getData("edu_complaints");
  const reviews = getData("edu_reviews");

  document.getElementById("homeworkCount").textContent = homework.length;
  document.getElementById("attendanceCount").textContent = attendance.length;
  document.getElementById("complaintCount").textContent = complaints.length;
  document.getElementById("reviewCount").textContent = reviews.length;

  renderList("homeworkList", homework, function(item) {
    return "<b>" + escapeHTML(item.subject) + "</b> — " +
      escapeHTML(item.className) + "<br>" +
      escapeHTML(item.details) + "<br><small>Due: " +
      escapeHTML(item.date) + "</small>";
  });

  renderList("attendanceList", attendance, function(item) {
    return "<b>" + escapeHTML(item.name) + "</b> — " +
      escapeHTML(item.className) + "<br>Status: " +
      escapeHTML(item.status) + "<br><small>" +
      escapeHTML(item.date) + "</small>";
  });

  renderList("complaintList", complaints, function(item) {
    return "<b>" + escapeHTML(item.name) + "</b> — " +
      escapeHTML(item.category) + "<br>" +
      escapeHTML(item.message) + "<br><br><b>Demo response:</b> " +
      escapeHTML(item.response);
  });

  renderList("reviewList", reviews, function(item) {
    return "<b>" + escapeHTML(item.name) + "</b> — " +
      "⭐".repeat(Number(item.rating)) + "<br>" +
      escapeHTML(item.message);
  });

  const activity = document.getElementById("recentActivity");
  const total = homework.length + attendance.length + complaints.length + reviews.length;
  activity.textContent = total ? total + " item(s) recorded on this device." : "No activity yet.";
}

function renderList(elementId, items, formatter) {
  const element = document.getElementById(elementId);

  if (!items.length) {
    element.innerHTML = '<p class="empty">No records yet.</p>';
    return;
  }

  element.innerHTML = items.slice().reverse().map(function(item) {
    return '<div class="item">' + formatter(item) + '</div>';
  }).join("");
}

function escapeHTML(value) {
  return String(value).replace(/[&<>"']/g, function(character) {
    return {
      "&": "&amp;",
      "<": "&lt;",
      ">": "&gt;",
      '"': "&quot;",
      "'": "&#039;"
    }[character];
  });
}

// Homework form
document.getElementById("homeworkForm").addEventListener("submit", function(event) {
  event.preventDefault();

  const items = getData("edu_homework");
  items.push({
    subject: document.getElementById("hwSubject").value.trim(),
    className: document.getElementById("hwClass").value.trim(),
    details: document.getElementById("hwDetails").value.trim(),
    date: document.getElementById("hwDate").value
  });

  saveData("edu_homework", items);
  this.reset();
  renderAll();
  alert("Homework added successfully!");
});

// Attendance form
document.getElementById("attendanceForm").addEventListener("submit", function(event) {
  event.preventDefault();

  const items = getData("edu_attendance");
  items.push({
    name: document.getElementById("attName").value.trim(),
    className: document.getElementById("attClass").value.trim(),
    status: document.getElementById("attStatus").value,
    date: new Date().toLocaleDateString()
  });

  saveData("edu_attendance", items);
  this.reset();
  renderAll();
  alert("Attendance saved successfully!");
});

// Complaint system: automatic demo responses, not a live AI service
function getComplaintResponse(category) {
  const responses = {
    "Academic Problem": "Your academic concern has been recorded. Please contact your class teacher for assistance.",
    "Teacher Related": "Your feedback has been recorded for school administration to review.",
    "Classroom Facilities": "Your facilities complaint has been recorded for review.",
    "Bullying or Safety": "Please report this concern to a trusted teacher or school safeguarding staff member as soon as possible.",
    "Other": "Your complaint has been recorded. Please contact school administration for further help."
  };

  return responses[category] || responses["Other"];
}

document.getElementById("complaintForm").addEventListener("submit", function(event) {
  event.preventDefault();

  const category = document.getElementById("compCategory").value;
  const items = getData("edu_complaints");

  items.push({
    name: document.getElementById("compName").value.trim(),
    category: category,
    message: document.getElementById("compText").value.trim(),
    response: getComplaintResponse(category)
  });

  saveData("edu_complaints", items);
  this.reset();
  renderAll();
  alert("Your complaint has been submitted!");
});

// Help Center
document.getElementById("helpForm").addEventListener("submit", function(event) {
  event.preventDefault();

  const question = document.getElementById("helpQuestion").value.toLowerCase();
  let answer = "Please contact your class teacher or school administration for more information.";

  if (question.includes("homework")) {
    answer = "Open the Homework section to see assigned homework.";
  } else if (question.includes("attendance")) {
    answer = "Open the Attendance section to view attendance records.";
  } else if (question.includes("complaint")) {
    answer = "Open AI Complaints to submit your concern.";
  } else if (question.includes("review") || question.includes("feedback")) {
    answer = "Open the Reviews section to share your feedback.";
  }

  document.getElementById("helpAnswer").innerHTML =
    '<div class="item"><b>EduSync Help:</b> ' + escapeHTML(answer) + '</div>';

  this.reset();
});

// Reviews
document.getElementById("reviewForm").addEventListener("submit", function(event) {
  event.preventDefault();

  const items = getData("edu_reviews");
  items.push({
    name: document.getElementById("reviewStudent").value.trim(),
    rating: document.getElementById("reviewRating").value,
    message: document.getElementById("reviewMessage").value.trim()
  });

  saveData("edu_reviews", items);
  this.reset();
  renderAll();
  alert("Thank you for your review!");
});

renderAll();
</script>

</body>
</html>
